NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ollama en local. Pour un serveur distant (app déployée sur Vercel), mettre
# l'URL HTTPS publique : OLLAMA_BASE_URL=https://ai.exemple.fr
# (OLLAMA_URL est accepté comme alias.)
OLLAMA_BASE_URL=http://localhost:11434
# Identifiants Basic Auth du reverse proxy qui protège l'Ollama distant.
# À laisser VIDES en local (pas de proxy, pas d'authentification).
# Ne les envoyer qu'en HTTPS : Basic Auth n'est qu'un encodage base64, pas un chiffrement.
OLLAMA_USER=
OLLAMA_PASSWORD=
# Sur un petit serveur (8 Go de RAM), viser un modèle léger : qwen2.5:1.5b
OLLAMA_MODEL=mistral
OLLAMA_ARTIFACT_MODEL=qwen2.5-coder:7b
# Modèle pour la recherche web (tool-calling). DOIT gérer les outils : llama3 NON,
# mais llama3.1 / qwen2.5 / mistral OUI. À récupérer via `ollama pull llama3.1`.
OLLAMA_TOOL_MODEL=llama3.1

# Fallback API (EU, tier gratuit) utilisé si Ollama est injoignable.
# https://console.mistral.ai/
MISTRAL_API_KEY=
# Chat principal : équivalent Llama 3 / Mistral local
MISTRAL_MODEL=mistral-small-latest
# Artefacts JSON : Codestral (équivalent qwen2.5-coder, spécialisé sortie structurée)
MISTRAL_ARTIFACT_MODEL=codestral-latest

# Recherche web (ancrage des réponses dans des infos réelles).
# Compte gratuit + clé sur https://tavily.com (la clé commence par "tvly-").
TAVILY_API_KEY=

# BYOK : secret de chiffrement des clés API utilisateur (table user_api_keys).
# 32 octets en hexadécimal (64 caractères). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ne JAMAIS commiter la vraie valeur. La changer = perdre l'accès aux clés déjà stockées.
API_KEY_ENCRYPTION_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
